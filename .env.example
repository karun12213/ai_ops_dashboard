# Application
APP_ENV=development
DEBUG=false
DOCS_ENABLED=true
AUTO_CREATE_TABLES=true

# Self-contained local API database
DATABASE_URL=sqlite+aiosqlite:///./backend/restaurant_ops.db

# Private audio object storage. Keep this path outside any public web root.
AUDIO_LOCAL_STORAGE_PATH=./backend/audio_uploads
# Hard ceiling is 104857600 bytes (100 MiB).
AUDIO_MAX_UPLOAD_BYTES=104857600

# External AI services used after a validated audio upload. Keep real values
# only in .env or the deployment secret manager.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=translate
SARVAM_TIMEOUT_SECONDS=90
SARVAM_MAX_RETRIES=2
SARVAM_RETRY_BACKOFF_SECONDS=1
SARVAM_SHORT_AUDIO_MAX_SECONDS=30
SARVAM_BATCH_TIMEOUT_SECONDS=1800
SARVAM_BATCH_POLL_SECONDS=5
SARVAM_COST_PER_AUDIO_HOUR_INR=30.00
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
OPENAI_TRANSCRIPT_CHUNK_CHARS=24000
OPENAI_INPUT_COST_PER_MILLION_USD=2.50
OPENAI_CACHED_INPUT_COST_PER_MILLION_USD=1.25
OPENAI_OUTPUT_COST_PER_MILLION_USD=10.00

# Optional executable names or absolute paths. Leave blank to resolve from PATH.
FFMPEG_BINARY=
FFPROBE_BINARY=
AUDIO_MAX_DURATION_SECONDS=7200

# Optional local development administrator (ignored unless APP_ENV is development).
# Keep credentials in the ignored .env file; do not commit them.
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_FULL_NAME=
DEFAULT_ADMIN_PASSWORD=

# PostgreSQL (used by Docker Compose and recommended for production)
POSTGRES_DB=restaurant_ops
POSTGRES_USER=restaurant_ops
POSTGRES_PASSWORD=replace-with-a-strong-password
# Production example:
# DATABASE_URL=postgresql+asyncpg://restaurant_ops:replace-with-a-strong-password@localhost:5432/restaurant_ops

# Authentication - generate a unique value of at least 32 characters
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting & login lockout (per backend process; not shared across
# multiple replicas/workers). None of this is a secret - values are safe
# defaults and can be tuned without affecting existing sessions.
RATE_LIMIT_LOGIN_IP_MAX=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_LOCKOUT_THRESHOLD=5
RATE_LIMIT_LOGIN_LOCKOUT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_LOCKOUT_DURATION_SECONDS=300
RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_IP_MAX=30
RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=60

# Comma-separated browser origins, without trailing slashes
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
# Optional custom regex. Development automatically allows localhost and
# 127.0.0.1 on any port so Flutter's random web-server port works.
CORS_ORIGIN_REGEX=
